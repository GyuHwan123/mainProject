# Docker Compose reads this file after you copy it to .env. Do not commit .env.
# Supabase is an external hosted project; no local database container is used.

# Frontend (Vite): browser-accessible URL, not Docker's internal backend hostname.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Backend: Docker Compose supplies OCR_BASE_URL=http://ocr:8001 and
# OLLAMA_BASE_URL=http://ollama:11434 automatically for container-to-container traffic.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key
SUPABASE_USERS_TABLE=users
SUPABASE_OCR_DOCUMENTS_TABLE=ocr_documents
SUPABASE_DOCUMENTS_BUCKET=documents
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=720
# Optional only for running the backend outside Docker.
# OCR_BASE_URL=http://127.0.0.1:8001
# OLLAMA_BASE_URL=http://127.0.0.1:11434
RAG_EMBEDDING_MODEL=BAAI/bge-m3
RAG_EMBEDDING_DIMENSIONS=1024
RAG_LLM_MODEL=gemma2:2b
RECEIPTS_LLM_MODEL=gemma3-4b-trained:latest
RAG_RERANK_MODEL=BAAI/bge-reranker-v2-m3
RAG_PROMPT_VERSION=baseline-v1
RAG_TOP_K=4
RAG_CHUNK_TARGET_CHARS=380

# Optional local full-model GGUF registration for receipt extraction.
# Put the GGUF and Modelfile under models/receipts/.
# RECEIPTS_LLM_MODEL must match the Ollama model name below.
# RECEIPTS_LLM_MODEL=gemma3-4b-trained:latest
# OLLAMA_RECEIPTS_MODELFILE=/models/receipts/Modelfile

# Optional local RAG GGUF registration. Put the file under models/rag/ and
# use its in-container absolute path. Set RAG_LLM_MODEL to the same model name.
# RAG_LLM_MODEL=my-qlora-rag:latest
# OLLAMA_RAG_MODEL=my-qlora-rag:latest
# OLLAMA_RAG_GGUF_PATH=/models/rag/my-qlora-rag.gguf
# Optional on Windows when LibreOffice is not installed in its default location.
# LIBREOFFICE_BIN=C:\Program Files\LibreOffice\program\soffice.com
